# ~~ Nix specific ignores ~~
# Result symlink generated by nix-build or nix build
result*
# Nix garbage collector roots
.gc-roots/
# Files generated by nix-shell
nix-shell.*
# Build directory sometimes used by Nix tools (though 'result' is more common)
_build/
# Direnv state if using 'use nix' or 'use flake'
.direnv/
# Locally checked out nixpkgs (if you do that within the project)
# nixpkgs/

# NOTE on flake.lock:
# Generally, you *should* commit 'flake.lock' to ensure reproducible builds
# for everyone using the flake. It pins the exact versions of your inputs.
# Uncomment the line below ONLY if you have a specific reason NOT to track it.
# flake.lock


# ~~ C/C++ Build Artifacts ~~
# Object files
*.o
*.obj

# Precompiled Headers
*.pch
*.gch

# Libraries
*.a
*.lib
*.so
*.dylib
*.dll

# Executables (often placed in build directories, see below)
# If you build executables directly in the source root without an extension (common on Unix):
# my_executable_name  # Replace with your actual executable name(s) if needed

# Build system directories and files
# Make / Autotools
Makefile # If generated by configure/CMake, otherwise don't ignore your source Makefile
configure # If generated
config.log
config.status
config.cache
autom4te.cache/
*.in # Often templates, but configure generates Makefiles from Makefile.in

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
# Common CMake build directory names
build/
_build/ # Also used by Nix sometimes
out/

# Meson
meson-build/
meson-logs/
meson-private/

# General build output directories
bin/
lib/
obj/
dist/
target/ # Common in Rust, but sometimes used elsewhere

# ~~ Testing & Coverage ~~
*.gcno
*.gcda
*.gcov
coverage/
.coverage
*.profraw # LLVM coverage
lcov/
test-*/ # If test output goes into directories like test-output/

# ~~ Documentation ~~
# Generated documentation (e.g., Doxygen)
docs/html/
docs/latex/
# Add other generated doc formats/folders if needed

# ~~ Editor & IDE specific files ~~
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Keep the above ! lines if you want to share common VSCode settings

# Vim / Neovim
*.swp
*.swo
*~
.*.swp
.*.swo
.vim/

# Emacs
*~
#*#
.#*

# JetBrains (CLion, etc)
.idea/
*.iml

# Sublime Text
*.sublime-workspace
*.sublime-project

# ~~ OS generated files ~~
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon? # Custom icon file on macOS

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ~~ Other ~~
# Log files
*.log

# Environment variables (NEVER commit secrets!)
.env*
*.env
!/.env.example # Often okay to commit example env files

# Dependency directories (if not managed by Nix, e.g., downloaded manually)
# deps/
# vendor/
