{
  pkgs,
  stdenv,
  lib,
  libremidi,
}:
stdenv.mkDerivation (finalAttrs: {
  pname = "libsoundio-libremidi-sine-synth";
  version = "0.1";

  src = ./.;

  nativeBuildInputs = [
    pkgs.pkg-config
  ];

  buildInputs = [
    pkgs.libsoundio
    pkgs.libremidi
    pkgs.alsa-lib
  ];

  # No configure step needed for this simple C file
  dontConfigure = true;

  buildPhase = ''
    runHook preBuild

    # Compile the simplified C++ file
    $CXX main.cpp -o "${finalAttrs.pname}" \
      -std=c++20 \
      -DLIBREMIDI_ALSA=1 \
      -DLIBREMIDI_HEADER_ONLY=1 \
      -lsoundio -lm -lasound -pthread

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    install -Dm755 "${finalAttrs.pname}" $out/bin/"${finalAttrs.pname}"

    runHook postInstall
  '';

  # Add rpath so the binary can find the libsoundio shared library at runtime
  fixupPhase = ''
    runHook preFixup
    patchelf --set-rpath "${pkgs.libsoundio}/lib" $out/bin/"${finalAttrs.pname}"
    runHook postFixup
  '';

  meta = with lib; {
    description = "Simple sine wave synth using libsoundio and libremidi for midi";
    platforms = platforms.all;
  };
})
